{
  "schemaVersion": 2,
  "hostId": "home-main",
  "driveRoot": "G:\\My Drive\\AI-Workbench",
  "driveReadyPath": "G:\\My Drive",
  "localStateRoot": "%LOCALAPPDATA%\\AIWorkbenchBridge",
  "startupDriveWaitSeconds": 600,
  "scanIntervalSeconds": 10,
  "eventFlushSeconds": 2,
  "eventFlushBytes": 65536,
  "eventMaxPendingBytes": 16777216,
  "outputDrainTimeoutSeconds": 30,
  "hostLeaseSeconds": 300,
  "maxParallelJobs": 6,
  "dispatcherPolicyWarnTokens": 4000,
  "push": { "enabled": true, "url": "https://co.example.org/agent/push.php", "credentialTarget": "aiwb/co-push", "minJobSeconds": 45, "ownerEnv": "anna" },
  "supervisor": { "enabled": true, "restartMode": "dry", "claimFailures": 5, "claimWindowMinutes": 10, "stuckJobMinutes": 30, "ownershipFailMinutes": 10, "drivePushMinutes": 20, "softResetWaitMinutes": 5, "drainTimeoutMinutes": 30, "startupGraceMinutes": 5, "maxRestartsPerHour": 2, "maxRestartsPerDay": 4, "launcherCheckSeconds": 120, "maxLauncherStartsPerDay": 3 },
  "maxProcessTimeoutMinutes": 240,
  "maxArtifactDestinationPathChars": 240,
  "transportRetentionDays": 30,
  "localLogRetentionDays": 14,
  "autoExportMaxFiles": 50,
  "autoExportMaxBytes": 209715200,
  "autoExportMaxFileBytes": 104857600,
  "autoExportMaxScanEntries": 200000,
  "chatProjectEnvironments": {
    "anna": {
      "allowedAgents": [
        "claude",
        "codex"
      ],
      "autoExport": true
    },
    "boris": {
      "allowedAgents": [
        "claude",
        "codex"
      ],
      "autoExport": true
    },
    "vera": {
      "allowedAgents": [
        "claude",
        "codex"
      ],
      "autoExport": true
    }
  },
  "contextRoots": {
    "gdrive": {
      "path": "G:\\My Drive",
      "label": "Google Drive — My Drive",
      "kind": "drive",
      "indexDepth": 3
    },
    "home": {
      "path": "%USERPROFILE%",
      "label": "PC — home",
      "kind": "local",
      "indexDepth": 3
    }
  },
  "devices": {
    "enabled": true,
    "maxCallsPerRun": 400,
    "degradedMaxCallsPerRun": 60,
    "callTimeoutSeconds": 120,
    "askUserTimeoutSeconds": 1800,
    "mcpOutputTokens": 25000,
    "scanSeconds": 15,
    "permissionPromptViaDevice": true,
    "driveFallback": true,
    "corporateDomains": ["corp.example.com"]
  },
  "runAs": {
    "user": "",
    "domain": ".",
    "credentialTarget": "AIWorkbench.Bridge.RunAs"
  },
  "contextIndexMaxEntries": 20000,
  "contextIndexRefreshHours": 6,
  "maxContextFolders": 10,
  "agents": {
    "codex": {
      "displayName": "Codex",
      "executable": "codex.exe",
      "arguments": [
        "exec",
        "--json",
        "--skip-git-repo-check",
        "--approve-for-me",
        "-"
      ],
      "promptToStdin": true,
      "outputProtocol": "codex-jsonl",
      "requireStructuredSuccess": true,
      "requiresGitRepository": false,
      "environment": {},
      "modes": {
        "chat": {
          "arguments": [
            "exec",
            "--json",
            "--skip-git-repo-check",
            "--approve-for-me",
            "-"
          ],
          "resumeExtraArguments": [
            "--skip-git-repo-check"
          ],
          "requiresGitRepository": false,
          "defaultTimeoutMinutes": 120
        },
        "cowork": {
          "arguments": [
            "exec",
            "--json",
            "--skip-git-repo-check",
            "--approve-for-me",
            "-"
          ],
          "resumeExtraArguments": [
            "--skip-git-repo-check"
          ],
          "defaultTimeoutMinutes": 120
        }
      },
      "modelArguments": [
        "-m",
        "{value}"
      ],
      "effortArguments": [
        "-c",
        "model_reasoning_effort={value}"
      ],
      "modelCatalogFile": "%USERPROFILE%\\.codex\\models_cache.json",
      "efforts": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "defaultModel": "gpt-6-astra",
      "defaultEffort": "medium",
      "rateLimitSessionsDir": "%USERPROFILE%\\.codex\\sessions"
    },
    "claude": {
      "displayName": "Claude",
      "executable": "claude.exe",
      "arguments": [
        "-p",
        "--output-format",
        "stream-json",
        "--verbose",
        "--permission-mode",
        "acceptEdits",
        "--allowedTools",
        "Read,Write,Edit,Bash,Glob,Grep,WebSearch,WebFetch"
      ],
      "promptToStdin": true,
      "outputProtocol": "claude-stream-json",
      "requireStructuredSuccess": true,
      "requiresGitRepository": false,
      "environment": {},
      "modes": {
        "chat": {
          "arguments": [
            "-p",
            "--output-format",
            "stream-json",
            "--verbose",
            "--permission-mode",
            "acceptEdits",
            "--allowedTools",
            "Read,Write,Edit,Bash,Glob,Grep,WebSearch,WebFetch"
          ],
          "defaultTimeoutMinutes": 120
        },
        "cowork": {
          "arguments": [
            "-p",
            "--output-format",
            "stream-json",
            "--verbose",
            "--permission-mode",
            "acceptEdits",
            "--allowedTools",
            "Read,Write,Edit,Bash,Glob,Grep,WebSearch,WebFetch"
          ],
          "defaultTimeoutMinutes": 120
        }
      },
      "modelArguments": [
        "--model",
        "{value}"
      ],
      "effortArguments": [
        "--effort",
        "{value}"
      ],
      "models": [
        {
          "id": "fable",
          "label": "Fable (latest)"
        },
        {
          "id": "opus",
          "label": "Opus (latest)"
        },
        {
          "id": "sonnet",
          "label": "Sonnet (latest)"
        }
      ],
      "efforts": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "defaultModel": null,
      "defaultEffort": null
    }
  },
  "projects": {
    "bridge-test": {
      "environmentId": "anna",
      "workspace": "G:\\My Drive\\AI-Workbench\\projects\\bridge-test\\workspace",
      "allowedAgents": [
        "codex",
        "claude"
      ],
      "allowedModes": [
        "chat",
        "cowork"
      ],
      "autoExport": true
    }
  },
  "google": {
    "enabled": true,
    "projectId": "<gcp-project-id-or-number>",
    "pubsub": true,
    "apiPollSeconds": 5,
    "pullThreads": 2
  }
}