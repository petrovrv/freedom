{
  "manifest_version": 3,
  "name": "AI Workbench",
  "short_name": "AI Workbench",
  "version": "0.1.0",
  "description": "CO chat in the side panel; the agent reads and works in your tabs (forms, mail drafts, multi-page applications) with your confirmation.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "scripting", "tabs", "storage", "debugger", "webNavigation", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "panel.html" },
  "action": { "default_title": "AI Workbench", "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+A" }, "description": "Open the AI Workbench panel" }
  }
}
