<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CO.Desktop</AssemblyName>
    <RootNamespace>CO.Desktop</RootNamespace>
    <Version>0.14.0</Version>
    <Product>CO Desktop</Product>
    <Company>Freedom contributors</Company>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationIcon>co.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.Net.Http" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="co.ico" LogicalName="CO.Desktop.co.ico" />
    <EmbeddedResource Include="co-browser.ico" LogicalName="CO.Desktop.co-browser.ico" />
    <EmbeddedResource Include="co-page.ico" LogicalName="CO.Desktop.co-page.ico" />
  </ItemGroup>

  <Import Project="..\..\ModuleParts.props" />

  <ItemGroup>
    <ProjectReference Include="..\CO.Core\CO.Core.csproj" />
    <!-- Freedom F10: desktop parts of modules (ModuleParts.props), compiled in; each one is registered only while its
         module is enabled in the workbench and on for this device (App.cs, ModuleParts). -->
    <ProjectReference Include="@(CoModulePart)" />
  </ItemGroup>

  <Target Name="CoModulePartsMetadata" BeforeTargets="GetAssemblyAttributes">
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'%(CoModulePart.Filename)' != ''">
        <_Parameter1>CO.ModulePart</_Parameter1>
        <_Parameter2>%(CoModulePart.Filename)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

</Project>
