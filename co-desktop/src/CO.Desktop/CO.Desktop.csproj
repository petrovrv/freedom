<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CO.Desktop</AssemblyName>
    <RootNamespace>CO.Desktop</RootNamespace>
    <Version>0.11.3</Version>
    <Product>CO Desktop</Product>
    <Company>Freedom contributors</Company>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationIcon>co.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.Net.Http" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="co.ico" LogicalName="CO.Desktop.co.ico" />
    <EmbeddedResource Include="co-browser.ico" LogicalName="CO.Desktop.co-browser.ico" />
    <EmbeddedResource Include="co-canvas.ico" LogicalName="CO.Desktop.co-canvas.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CO.Core\CO.Core.csproj" />
    <!-- Freedom F1: corporate connectors module, compiled in; registered only when desktop.json CorporateConnectors is on. -->
    <ProjectReference Include="..\..\..\connectors\corporate\desktop\CO.Corporate.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

</Project>
