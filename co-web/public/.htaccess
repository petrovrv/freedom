DirectoryIndex index.html
Options -Indexes

RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# SPA fallback: client-side routes resolve to index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # 0.62.0: no X-Frame-Options; CSP frame-ancestors lets only the AI Workbench browser extension panel frame CO
  # F10 (modules, SPEC §3.6): frame-src also allows 'self' - module pages (agent/module.php) in sandboxed iframes of CO Web
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set Permissions-Policy "camera=(), microphone=(self), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; connect-src 'self' https://www.googleapis.com https://oauth2.googleapis.com https://accounts.google.com/gsi/ https://pubsub.googleapis.com https://firestore.googleapis.com; frame-src 'self' https://accounts.google.com/gsi/; img-src 'self' data: blob:; worker-src 'self'; manifest-src 'self'; object-src 'none'; frame-ancestors chrome-extension://eobijkacekfneefkngaejdcdaehfijaf; base-uri 'self'; form-action 'none'"
  # F10: only module pages may be framed by CO Web itself; their own policy (no network, opaque origin even outside a frame)
  <If "%{REQUEST_URI} =~ m#^/agent/module\.php#">
    Header always set Content-Security-Policy "sandbox allow-scripts allow-forms; default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'none'; frame-ancestors 'self' chrome-extension://eobijkacekfneefkngaejdcdaehfijaf; base-uri 'none'; form-action 'none'"
  </If>
</IfModule>

<FilesMatch "(index\.html|lab\.html|sw\.js|manifest\.webmanifest)$">
  Header set Cache-Control "no-cache"
</FilesMatch>
<If "%{REQUEST_URI} =~ m#^/assets/#">
  Header set Cache-Control "public, max-age=31536000, immutable"
</If>
