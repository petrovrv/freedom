{
  "schema": 1,
  "id": "assoc-search",
  "version": "0.1.0",
  "title": "Associative search",
  "description": "Finds chats by meaning and by other names of things, not only by the exact words: vectors of protocol entries (a small multilingual model on the home PC) and an alias dictionary (Wikidata labels, names suggested by a model, own names). Adds its list to the chat search of CO Web, aiwb-chat find and the secretary's hints.",
  "ext": ">=1 <2",
  "scope": "household",
  "platforms": ["windows", "macos", "linux"],
  "requires": { "core": ["search"], "modules": [] },
  "permissions": ["chats.read", "data.own", "search.provider", "host.key"],
  "isolation": "host",
  "isolationReason": "the indexer runs the embedding model on the home PC and writes vectors and aliases with the host key",
  "provides": {
    "ui": [],
    "tools": [{ "name": "aiwb-assoc", "minVersion": "0.2.0" }],
    "services": [{ "id": "indexer", "tool": "aiwb-assoc", "run": "index", "kind": "schedule", "cron": "20 * * * *", "windowsTask": "\\AIWorkbench\\AssocIndex" }],
    "data": { "server": "tables m_assoc_search_vec_words, m_assoc_search_vec_protocol, m_assoc_search_aliases", "home": "model cache of aiwb-assoc" },
    "search": [{ "id": "vector", "hooks": ["expand", "chats"] }],
    "events": [], "context": [], "models": [], "deviceTools": []
  },
  "server": {
    "entry": "server/ops.php",
    "ops": { "user": [], "push": [], "host": ["vec_todo", "vec_put", "vec_words", "vec_texts", "protocol_texts", "alias_put", "alias_list", "alias_delete"] }
  },
  "dataPolicy": { "onDisable": "keep", "onRemove": "ask", "migrations": "additive" },
  "defaults": { "enabled": false }
}
