{
  "schema": 1,
  "id": "chat-import",
  "version": "0.2.1",
  "title": "Import chats",
  "description": "Brings chats and projects from claude.ai and ChatGPT into the workbench: a page that reads an official data export in the browser, and tools at home that keep copying new chats every night.",
  "ext": ">=1 <2",
  "scope": "environment",
  "platforms": [
    "windows",
    "macos",
    "linux"
  ],
  "requires": {
    "core": [
      "projects",
      "chats"
    ],
    "modules": []
  },
  "permissions": [
    "ui.page",
    "import.write",
    "tools",
    "secrets"
  ],
  "provides": {
    "ui": [
      {
        "slot": "ui.page",
        "id": "import",
        "entry": "ui/import.html",
        "title": "Import chats from claude.ai or ChatGPT",
        "label": "Import",
        "app": true,
        "icon": "📥"
      }
    ],
    "import": [
      {
        "source": "claude",
        "label": "claude.ai",
        "page": "import",
        "tool": "claude-ai-sync",
        "speaker": "Claude (claude.ai)"
      },
      {
        "source": "chatgpt",
        "label": "ChatGPT",
        "page": "import",
        "tool": "chatgpt-sync",
        "speaker": "ChatGPT"
      }
    ],
    "tools": [
      {
        "name": "claude-ai-sync",
        "minVersion": "0.3.1"
      },
      {
        "name": "chatgpt-sync",
        "minVersion": "0.4.0"
      }
    ],
    "services": [],
    "secrets": [
      "aiwb/claude-ai",
      "aiwb/chatgpt"
    ],
    "data": {
      "server": "none",
      "home": "tool caches (claude-ai-sync, chatgpt-sync); the import index imports/index.json of the core"
    },
    "context": [],
    "models": [],
    "deviceTools": [],
    "events": [],
    "agentSchedules": [
      {
        "id": "nightly-sync",
        "cron": "30 4 * * *",
        "mode": "cowork",
        "tools": [
          "claude-ai-sync",
          "chatgpt-sync"
        ],
        "task": "fetch -> pending -> assign (pick a project by title and first words, or make one) -> import, for claude-ai-sync and chatgpt-sync",
        "note": "an agent job (Bridge schedules.json of a project), not a service: the module never starts it by itself, so a workbench that already has this schedule does not get a second run"
      }
    ]
  },
  "localOnly": [
    "src/",
    "tests/",
    "build.mjs",
    "tsconfig.json"
  ],
  "dataPolicy": {
    "onDisable": "keep",
    "onRemove": "keep",
    "migrations": "additive"
  },
  "defaults": {
    "enabled": false
  }
}
