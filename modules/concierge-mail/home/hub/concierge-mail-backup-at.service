# One mailbox per instance (%i = person slug): own system user, own data directory, own account credential (module provider-accounts).
[Unit]
Description=Freedom concierge-mail: encrypted Drive backup for %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=cmail-%i
Group=cmail-%i
EnvironmentFile=/etc/concierge-mail/%i.env
LoadCredentialEncrypted=account:/etc/credstore.encrypted/account.%i.google.cred
ExecStart=/usr/bin/python3 /opt/concierge-mail/modules/concierge-mail/home/mailcli.py --root /srv/data/mail/%i backup-drive
TimeoutStartSec=infinity
Nice=15
IOSchedulingClass=idle
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/srv/data/mail/%i
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=1G
