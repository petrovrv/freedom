# One mailbox per instance (%i = person slug): the person's Mail page reaches this worker through the site (sealed
# requests and answers; the site never sees mail in clear). Read only: it answers from the person's store.
[Unit]
Description=Freedom concierge-mail: Mail page worker for %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aiwb-%i
Group=aiwb-%i
EnvironmentFile=/etc/concierge-mail/%i.env
LoadCredentialEncrypted=relay:/etc/credstore.encrypted/concierge-mail-relay.%i.cred
ExecStart=/usr/bin/python3 /opt/concierge-mail/modules/concierge-mail/home/mailcli.py --root /srv/data/mail/%i relay-serve
Restart=always
RestartSec=10
Nice=5
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/srv/data/mail/%i
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=512M

[Install]
WantedBy=multi-user.target
