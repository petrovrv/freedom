{
  "schema": 1,
  "id": "concierge-mail",
  "version": "0.7.1",
  "title": "Mail concierge",
  "ext": ">=1 <2",
  "scope": "environment",
  "platforms": [
    "windows",
    "linux",
    "macos"
  ],
  "requires": {
    "core": [
      "push"
    ],
    "modules": []
  },
  "permissions": [
    "context",
    "net.outbound:imap.gmail.com",
    "net.outbound:gmail.googleapis.com",
    "net.outbound:oauth2.googleapis.com",
    "net.outbound:www.googleapis.com",
    "net.outbound:accounts.google.com",
    "secrets.read",
    "push.key"
  ],
  "isolation": "choice",
  "defaults": {
    "enabled": false
  },
  "dataPolicy": {
    "onDisable": "keep",
    "onRemove": "keep",
    "migrations": "additive"
  },
  "provides": {
    "context": [
      {
        "file": "context/mail.md"
      }
    ],
    "services": [
      {
        "id": "briefing",
        "kind": "schedule",
        "every": "PT10M",
        "cwd": "home",
        "run": "python mailcli.py deliver tick"
      }
    ],
    "data": {
      "home": "concierge-mail/ next to install.json (archive, delivery.json with the person's channels and time)"
    }
  }
}
