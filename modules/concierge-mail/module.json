{
  "schema": 1,
  "id": "concierge-mail",
  "version": "0.11.6",
  "title": "Mail concierge",
  "description": "Mail app (✉) of the person: the whole mailbox lives on the home server (one store per person, read-only Gmail sync, encrypted backup into the person's own Drive); the page reaches it through the module home-relay (the site carries only end-to-end encrypted requests and answers). Plus the morning briefing and its delivery.",
  "ext": ">=1 <2",
  "scope": "environment",
  "platforms": [
    "windows",
    "linux",
    "macos"
  ],
  "requires": {
    "core": [
      "push"
    ],
    "modules": [
      "provider-accounts",
      "home-relay"
    ]
  },
  "permissions": [
    "context",
    "net.outbound:imap.gmail.com",
    "net.outbound:gmail.googleapis.com",
    "net.outbound:oauth2.googleapis.com",
    "net.outbound:www.googleapis.com",
    "net.outbound:accounts.google.com",
    "secrets.read",
    "push.key",
    "net.outbound:openidconnect.googleapis.com",
    "ui.header",
    "ui.navigate"
  ],
  "isolation": "choice",
  "defaults": {
    "enabled": false
  },
  "provides": {
    "context": [
      {
        "file": "context/mail.md"
      }
    ],
    "services": [
      {
        "id": "briefing",
        "kind": "schedule",
        "every": "PT10M",
        "cwd": "home",
        "run": "python mailcli.py deliver tick"
      }
    ],
    "data": {
      "home": "concierge-mail/ next to install.json (archive, delivery.json with the person's channels and time); on the home server /srv/data/mail/<slug> per person",
      "server": "none of its own: sealed items pass through the module home-relay"
    },
    "ui": [
      {
        "slot": "ui.page",
        "id": "mail",
        "entry": "ui/mail.html",
        "title": "Почта",
        "app": true,
        "icon": "✉",
        "label": "Почта",
        "window": true
      },
      {
        "slot": "ui.header",
        "id": "tray",
        "entry": "ui/tray.html",
        "title": "Почта: непрочитанные"
      }
    ],
    "navigate": [
      "/x/concierge-mail/mail"
    ]
  },
  "server": {
    "entry": "server/ops.php",
    "ops": {
      "user": [
        "mail_status",
        "mail_call"
      ],
      "push": [],
      "host": []
    }
  },
  "dataPolicy": {
    "onDisable": "keep",
    "onRemove": "keep",
    "migrations": "additive"
  }
}
