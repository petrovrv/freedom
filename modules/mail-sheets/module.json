{
  "schema": 1,
  "id": "mail-sheets",
  "version": "0.1.0",
  "title": "Mail and spreadsheets",
  "description": "Gmail over IMAP (download attachments, drafts with links and large attachments - never sends -, labels and presets) and Google Sheets read/write with the workbench's Google sign-in, for when the chat connectors cannot. gsheets-bridge reuses the Google token Bridge keeps in the Windows Credential Manager (Windows only).",
  "ext": ">=1 <2",
  "scope": "environment",
  "platforms": [
    "windows",
    "macos",
    "linux"
  ],
  "requires": {
    "core": [],
    "modules": []
  },
  "permissions": [
    "net.outbound:imap.gmail.com",
    "net.outbound:sheets.googleapis.com",
    "secrets.read"
  ],
  "isolation": "choice",
  "isolationReason": "the tools need only the internet and their keyring secrets; in a sandbox the secrets must be given to the sandbox",
  "provides": {
    "tools": [
      {
        "name": "gmail-attachments",
        "minVersion": "0.2.1"
      },
      {
        "name": "gmail-draft",
        "minVersion": "0.2.2"
      },
      {
        "name": "gmail-label",
        "minVersion": "0.6.1"
      },
      {
        "name": "gsheets-bridge",
        "minVersion": "0.2.0"
      }
    ],
    "secrets": [
      {
        "name": "aiwb/gmail",
        "account": "the mail address",
        "why": "Gmail app password for IMAP"
      }
    ],
    "ui": [],
    "services": [],
    "events": [],
    "context": [],
    "models": [],
    "deviceTools": []
  },
  "dataPolicy": {
    "onDisable": "keep",
    "onRemove": "keep",
    "migrations": "additive"
  },
  "defaults": {
    "enabled": false
  }
}
