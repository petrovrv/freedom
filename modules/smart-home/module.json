{
  "schema": 1,
  "id": "smart-home",
  "version": "0.4.0",
  "title": "Дом",
  "description": "Home app: rooms, lights and sockets, sensor readings, thermostat targets and Zigbee pairing; a tray chip while pairing runs; the agent reads the state of the house through the app action home_state.",
  "ext": ">=1 <2",
  "scope": "household",
  "platforms": [
    "windows"
  ],
  "requires": {
    "core": [],
    "modules": []
  },
  "permissions": [
    "ui.header",
    "data.own",
    "ui.navigate"
  ],
  "isolation": "host",
  "isolationReason": "The worker controls the household Zigbee coordinator",
  "provides": {
    "ui": [
      {
        "slot": "ui.header",
        "id": "pair",
        "entry": "ui/header.html",
        "title": "Zigbee pairing status"
      },
      {
        "slot": "ui.page",
        "id": "home",
        "entry": "ui/home.html",
        "title": "Дом",
        "app": true,
        "icon": "🏠",
        "label": "Дом"
      }
    ],
    "tools": [
      {
        "name": "homehub",
        "minVersion": "0.3.1"
      }
    ],
    "services": [
      {
        "id": "pairing",
        "tool": "homehub",
        "run": "home-worker"
      }
    ],
    "navigate": [
      "/x/smart-home/home"
    ],
    "actions": [
      {
        "op": "home_state",
        "outward": false,
        "description": "State of the house: every light, socket, sensor and thermostat (entity id, name, room, state, attributes, actions a person may run on it) and whether the home worker is online. Read only.",
        "args": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "op": "home_control",
        "outward": true,
        "description": "Switch a light or socket on/off or set a thermostat target. Acts on devices of the house, so only a person runs it (from the Home app).",
        "args": {
          "type": "object",
          "properties": {
            "entity": {
              "type": "string",
              "description": "entity id from home_state, e.g. light.kitchen"
            },
            "action": {
              "type": "string",
              "enum": [
                "turn_on",
                "turn_off",
                "set_temperature"
              ]
            },
            "value": {
              "type": "number",
              "description": "target temperature for set_temperature"
            },
            "requestKey": {
              "type": "string",
              "description": "16-80 characters [A-Za-z0-9-], the same key repeats nothing"
            }
          },
          "required": [
            "entity",
            "action",
            "requestKey"
          ]
        }
      }
    ]
  },
  "server": {
    "entry": "server/ops.php",
    "ops": {
      "user": [
        "home_pair_state",
        "home_pair_start",
        "home_pair_stop",
        "home_state",
        "home_control"
      ],
      "host": [
        "home_pair_exchange",
        "home_exchange"
      ],
      "push": []
    }
  },
  "dataPolicy": {
    "onDisable": "keep",
    "onRemove": "keep",
    "migrations": "additive"
  },
  "defaults": {
    "enabled": false
  },
  "installConfig": {
    "members": "smartHome.members"
  }
}
